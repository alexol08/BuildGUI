from tkinter import *
root=Tk()
root.title("Music Player")
root.geometry("300x350")
top_frame = Frame(root)
top_frame.pack(pady=10)
label=Label(top_frame, text='Now Playing...', font=('Arial', 14))
label.pack()
song_list=Listbox(top_frame, width=30, height=8)
song_list.pack()
song_list.insert(END, "song A- The Intro")
song_list.insert(END, "Song B- Cool Beats")
song_list.insert(END, "song C- Rap")
song_list.insert(END, "Song D- Piano")
song_list.insert(END, "song E- The outro")

bottom_frame = Frame(root)
bottom_frame.pack(pady=10)
play_btn=Button(bottom_frame, text="Play", bg='Lightgreen', width=8)
play_btn.pack(side=LEFT, padx=5)
pausebtn=Button(bottom_frame, text="Pause", bg="orange", width=8)
pausebtn.pack(side=LEFT, padx=5)
next_btn = Button(bottom_frame, text = "Next", bg="lightblue", width=8)
next_btn.pack(side=LEFT, padx=5)
root.mainloop()
