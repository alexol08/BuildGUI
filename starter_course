from tkinter import *
window=Tk()
window.geometry('500x500')
window.config(bg='blue')
label1=Label(window, text='Hello', bg='blue', font=('Arial', 50), fg= 'white')
label1.grid(row=1, column=1)

ent=Entry(window)
ent.grid(row=20, column=20)

txt=Text(window)
txt.grid(row=100, column=100)

bu=Button(window, text='Submit', bg='blue', fg='purple', command=window.destroy)
bu.grid(row=500, column=500)





window.mainloop()
